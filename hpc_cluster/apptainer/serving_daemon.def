Bootstrap: docker
From: ubuntu:24.04

# serving_daemon.def -- PLAN.md Phase 22 step 9: real Apptainer definition
# file wrapping inference_serving/serving_backend/serving_daemon (the
# SAME real long-running TCP inference process containers/Dockerfile
# already wraps for step 1 of Phase 16 -- this file deliberately builds
# the identical target via the identical cmake preset/build invocation,
# so the two container approaches are a fair, apples-to-apples contrast,
# not two differently-scoped builds).
#
# TOOLCHAIN-GATED, UNRUN, same as Dockerfile: no Apptainer or Docker
# runtime is installed on this Mac. UNLIKE Slurm (see
# slurm_jobs/README.md), this session confirmed via `brew info apptainer`
# that a real, current, bottled Homebrew formula DOES exist (1.5.3,
# "Application container and unprivileged sandbox platform for Linux" --
# old name Singularity, dependencies libseccomp + squashfs) -- not
# installed this session (no explicit ask/grant for it, same
# no-new-local-installs policy as every other toolchain in this phase).
# Even if installed, Apptainer's own formula description says "for
# Linux": its core sandboxing mechanism is UNPRIVILEGED LINUX USER
# NAMESPACES, a kernel feature with no macOS equivalent -- the same class
# of gap Docker Desktop papers over with a hidden Linux VM. So unlike
# `open-mpi`/`libomp` (step 1/2, which run natively on macOS once
# installed), installing `apptainer` via brew here would get real CLI
# tooling but NOT real container execution -- that stays genuinely
# Linux-gated regardless of the install decision, same as Docker itself.

%files
    . /src

%post
    apt-get update && apt-get install -y --no-install-recommends \
        clang \
        ninja-build \
        python3 \
        python3-pip \
        pkg-config \
        git \
        ca-certificates
    pip3 install --break-system-packages --no-cache-dir "cmake>=3.28"
    cd /src
    cmake --preset debug -DCMAKE_CXX_COMPILER=clang++
    cmake --build --preset debug --target serving_daemon

%environment
    export SERVING_PORT=8080

%startscript
    exec /src/build/debug/inference_serving/serving_backend/serving_daemon

%labels
    Author cross_machine_runtime
    Phase 22 step 9 -- Apptainer vs. Docker contrast

%help
    Real Apptainer definition wrapping inference_serving's serving_daemon
    (the same binary containers/Dockerfile wraps). Build (on real Linux
    with Apptainer installed):
        apptainer build serving_daemon.sif serving_daemon.def
    Run (no daemon, no root -- see README.md's contrast with `docker run`):
        apptainer run serving_daemon.sif
